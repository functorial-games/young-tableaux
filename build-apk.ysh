# Grease (pinned Oils-derived YSH implementation), build HOST only.
# Invoke: grease build-apk.ysh /absolute/repository /absolute/sdk /absolute/ndk /absolute/keystore
if (len(ARGV) !== 4) {
  echo 'usage: build-apk.ysh PROJECT SDK NDK STABLE_KEYSTORE (absolute paths)'
  exit 2
}
var project = $1
var sdk = $2
var ndk = $3
var signer = $4
for path in ([project, sdk, ndk, signer]) {
  if (not path.startsWith('/')) {
    echo 'FAIL: all build paths must be absolute'
    exit 2
  }
}
var tools = "$sdk/build-tools/35.0.0"
var clang_bin = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
var glue = "$ndk/sources/android/native_app_glue"
var output = "$project/build"
test -f "$project/app/AndroidManifest.xml"
test -f "$project/app/assets/facts.lua"
test -f "$project/third_party/lua/onelua.c"
var lua_head = $(git -C "$project/third_party/lua" rev-parse HEAD)
if (lua_head !== '87306483cec50f8c750a22dda1d0742246fad756') {
  echo "FAIL: symbolic Lua fork commit: $lua_head"
  exit 2
}
var lua_tree = $(git -C "$project/third_party/lua" rev-parse 'HEAD^{tree}')
var lua_status = $(git -C "$project/third_party/lua" status --porcelain)
if (lua_tree !== '6b2968928611542c8f82448f49c32ea8bc98b559' or lua_status !== '') {
  echo 'FAIL: modified or substituted Lua source tree'
  exit 2
}
test -f "$sdk/platforms/android-34/android.jar"
test -x "$clang_bin/armv7a-linux-androideabi26-clang"
test -f "$signer"
var certificate = $(keytool -list -v -keystore "$signer" -storepass wegert-debug -alias wegert-debug)
echo "$certificate" | rg -q 'SHA256: DE:9B:1D:47:C5:A6:5E:6D:46:A2:04:B7:9D:D9:EE:56:6B:9D:3C:98:32:BA:81:EB:C4:21:3D:33:92:E9:2F:F9'
mkdir -p "$output/objects" "$output/staging/lib/armeabi-v7a"
make -f "$project/icky/Android.mk" native ABI=armeabi-v7a NDK="$ndk" BUILD="$output/objects" OUT="$output/staging/lib/armeabi-v7a/libyoungtableaux.so"
"$clang_bin/llvm-strip" --strip-unneeded "$output/staging/lib/armeabi-v7a/libyoungtableaux.so"
"$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" -A "$project/app/assets" --manifest "$project/app/AndroidManifest.xml" --min-sdk-version 26 --target-sdk-version 34 --version-code 9 --version-name 0.4.0 -o "$output/unsigned.apk"
cd "$output/staging"
touch -t 198001010000 lib/armeabi-v7a/libyoungtableaux.so
zip -X -0 -q "$output/unsigned.apk" lib/armeabi-v7a/libyoungtableaux.so
"$tools/zipalign" -f -P 16 4 "$output/unsigned.apk" "$output/aligned.apk"
"$tools/apksigner" sign --ks "$signer" --ks-key-alias wegert-debug --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --out "$output/young-tableaux-armeabi-v7a.apk" "$output/aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$output/young-tableaux-armeabi-v7a.apk" | tee "$output/signing.txt"
rg -q 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signing.txt"
"$clang_bin/llvm-readelf" -h -A -l "$output/staging/lib/armeabi-v7a/libyoungtableaux.so" > "$output/abi.txt"
"$tools/aapt2" dump badging "$output/young-tableaux-armeabi-v7a.apk" > "$output/package.txt"
sha256sum "$output/young-tableaux-armeabi-v7a.apk" | tee "$output/apk.sha256"
git -C "$project" rev-parse HEAD > "$output/source.txt"
printf '\033[32mPASS ARMv7 APK built and signature verified\033[0m\n'
