registry_symbol (display_partition _) = "DisplayPartition"
registry_symbol (conjugate_partition _) = "ConjugatePartition"
registry_symbol (list_cells _) = "ListCells"
registry_symbol (display_tableau _) = "DisplayTableau"
registry_symbol (validate_tableau _ _ _) = "ValidateTableau"
registry_symbol (standardize_tableau _) = "StandardizeTableau"
registry_symbol (insert_letter _ _) = "InsertLetter"
registry_symbol (reverse_insertion _ _) = "ReverseInsert"
registry_symbol (transpose_filling _) = "TransposeTableau"
registry_symbol (compute_hook_lengths _) = "ComputeHookLengths"
registry_symbol (compute_hook_product _) = "ComputeHookProduct"
registry_symbol (count_standard_tableaux _) = "CountStandardTableaux"
registry_symbol (find_corners _) = "FindCorners"
registry_symbol (find_addable_cells _) = "FindAddableCells"
registry_symbol (find_removable_cells _) = "FindRemovableCells"
registry_symbol (add_partition_cell _ _) = "AddCell"
registry_symbol (remove_partition_cell _ _) = "RemoveCell"
registry_symbol (rsk_from_permutation _) = "RSKPermutation"
registry_symbol (rsk_from_word _) = "RSKWord"
registry_symbol (rsk_from_biword _) = "RSKBiword"
registry_symbol (rsk_from_matrix _) = "RSKMatrix"
registry_symbol (inverse_rsk _ _) = "InverseRSK"
registry_symbol (jeu_de_taquin_slide _ _) = "JeuDeTaquinSlide"
registry_symbol (rectify_tableau _) = "Rectify"
registry_symbol (promote_tableau _) = "Promote"
registry_symbol (evacuate_tableau _) = "Evacuate"
registry_symbol (lr_coefficient _ _ _) = "LittlewoodRichardsonCoefficient"
registry_symbol (enumerate_lr_tableaux _ _ _) = "EnumerateLRTableaux"
registry_symbol (multiply_schur_functions _ _) = "MultiplySchurFunctions"
registry_symbol (symmetric_character_value _ _) = "CharacterValue"
registry_symbol (representation_dimension _) = "RepresentationDimension"
registry_symbol (change_symmetric_basis _ _) = "ChangeBasis"
registry_symbol (specialize_symmetric_function _ _) = "Specialize"
registry_symbol (compose_symmetric_functions _ _) = "Plethysm"
registry_symbol (branch_partition_up _) = "BranchUp"
registry_symbol (branch_partition_down _) = "BranchDown"
registry_symbol (enumerate_young_graph_paths _ _) = "EnumerateYoungGraphPaths"
registry_symbol (generate_random_permutation _ _) = "GenerateRandomPermutation"
registry_symbol (generate_random_standard_tableau _ _) = "GenerateRandomStandardTableau"
registry_symbol (sample_plancherel_partition _ _) = "SamplePlancherelPartition"
registry_symbol (longest_increasing_subsequence _) = "ComputeLongestIncreasingSubsequence"
registry_symbol (longest_decreasing_subsequence _) = "ComputeLongestDecreasingSubsequence"
registry_symbol (coxeter_word _) = "CoxeterReducedWord"
registry_symbol (bruhat_relation _ _) = "BruhatRelations"

cell_text : Cell → Text
cell_text cell = "(" ++ show cell.row ++ "," ++ show cell.column ++ ")"

partition_text : Partition → Text
partition_text shape = show shape.rows

partition_view : Text → Partition → LaboratoryView
partition_view title shape = Inspection title
  ["Rows: " ++ partition_text shape, "Cells: " ++ show (partition_size shape)] [] [shape] []

tableau_view : Text → Tableau → LaboratoryView
tableau_view title tableau = Inspection title
  ["Rows: " ++ show tableau.rows] [tableau] [] []

cells_view : Text → List Cell → LaboratoryView
cells_view title cells = Inspection title
  (("Count: " ++ show (length cells)) :: map cell_text cells) [] [] []

integer_view : Text → Integer → LaboratoryView
integer_view title value = Inspection title [show value] [] [] []

sequence_view : Text → List Integer → LaboratoryView
sequence_view title values = Inspection title
  [show values, "Length: " ++ show (length values)] [] [] []

rsk_view : Text → RSKResult → LaboratoryView
rsk_view title result = Inspection title
  ["P: " ++ show result.insertion.rows, "Q: " ++ show result.recording.rows,
   "Inserted letters: " ++ show result.step,
   "Last bump path: " ++ concat (intersperse " → " (map cell_text result.path))]
  [result.insertion, result.recording] [] []

skew_view : Text → SkewTableau → LaboratoryView
skew_view title filling = Inspection title
  ["Outer: " ++ show filling.outer.rows, "Inner: " ++ show filling.inner.rows,
   "Visible rows: " ++ show filling.rows] [] [] [filling]

symmetric_view : Text → SymmetricFunction → LaboratoryView
symmetric_view title result = Inspection title
  (case symmetric_text result of
     Left reason ⇒ ["Invalid symmetric output: " ++ reason]
     Right rendered ⇒ [rendered, "Terms: " ++ show (length result.terms)])
  [] (map (\term ⇒ term.index) result.terms) []

partitions_view : Text → List Partition → LaboratoryView
partitions_view title values = Inspection title
  (("Count: " ++ show (length values)) :: map partition_text values) [] values []

rng_text : RNGState → Text
rng_text stream = "Next SplitMix64 state: " ++ show (the Integer (cast stream.state))

rule_text : filling_rule → Text
rule_text arbitrary_filling = "Arbitrary filling"
rule_text row_standard_filling = "Row standard filling"
rule_text column_standard_filling = "Column standard filling"
rule_text standard_filling = "Standard tableau"
rule_text semistandard_filling = "Positive semistandard tableau"

order_text : entry_order → Text
order_text increasing_entries = "Increasing entries"
order_text decreasing_entries = "Decreasing entries"

hook_tableau : List (Cell, Number) → Tableau
hook_tableau hooks = MkTableau (map values_in_row rows)
  where
    rows : List Number
    rows = nub (map (\(cell, _) ⇒ cell.row) hooks)

    values_in_row : Number → List Integer
    values_in_row row = map (\(_, length) ⇒ cast length)
      (filter (\(cell, _) ⇒ cell.row ≟ row) hooks)

public export
project : (request : operation) → OutputFor request → LaboratoryView
project (display_partition _) result = partition_view "Display partition" result
project (conjugate_partition _) result = partition_view "Conjugate partition" result
project (list_cells _) result = cells_view "List cells" result
project (display_tableau _) result = tableau_view "Display tableau" result
project (validate_tableau rule order _) result = Inspection "Validate tableau"
  [rule_text rule, order_text order, "Property holds: " ++ show result] [] [] []
project (standardize_tableau _) result = tableau_view "Standardize tableau" result
project (insert_letter _ _) result = Inspection "Insert letter"
  ["Inserted: " ++ show result.inserted, "New cell: " ++ cell_text result.new_cell,
   "Bump path: " ++ concat (intersperse " → " (map cell_text result.path))]
  [result.tableau] [] []
project (reverse_insertion _ _) (tableau, value) = Inspection "Reverse insertion"
  ["Ejected: " ++ show value, "Rows: " ++ show tableau.rows] [tableau] [] []
project (transpose_filling _) result = tableau_view "Transpose tableau" result
project (compute_hook_lengths _) result = Inspection "Hook lengths"
  (map (\(cell, length) ⇒ cell_text cell ++ ": " ++ show length) result)
  [hook_tableau result] [] []
project (compute_hook_product _) result = integer_view "Hook product" result
project (count_standard_tableaux _) result = integer_view "Count standard tableaux" result
project (find_corners _) result = cells_view "Find corners" result
project (find_addable_cells _) result = cells_view "Find addable cells" result
project (find_removable_cells _) result = cells_view "Find removable cells" result
project (add_partition_cell _ _) result = partition_view "Add selected cell" result
project (remove_partition_cell _ _) result = partition_view "Remove selected cell" result
project (rsk_from_permutation _) result = rsk_view "RSK permutation" result
project (rsk_from_word _) result = rsk_view "RSK word" result
project (rsk_from_biword _) result = rsk_view "RSK biword" result
project (rsk_from_matrix _) result = rsk_view "RSK matrix" result
project (inverse_rsk _ _) result = sequence_view "Inverse RSK" result
project (jeu_de_taquin_slide _ _) result = skew_view "Jeu de taquin slide" result
project (rectify_tableau _) result = skew_view "Rectify" result
project (promote_tableau _) result = tableau_view "Promotion" result
project (evacuate_tableau _) result = tableau_view "Evacuation" result
project (lr_coefficient _ _ _) result = integer_view "LR coefficient" result
project (enumerate_lr_tableaux _ _ _) result = Inspection "Enumerate LR tableaux"
  (("Count: " ++ show (length result)) :: map (\filling ⇒ show filling.rows) result)
  [] [] result
project (multiply_schur_functions _ _) result = symmetric_view "Schur product" result
project (symmetric_character_value _ _) result = integer_view "Character value" result
project (representation_dimension _) result = integer_view "Representation dimension" result
project (change_symmetric_basis _ _) result = symmetric_view "Change basis" result
project (specialize_symmetric_function _ _) result = Inspection "Specialize"
  [rational_text result] [] [] []
project (compose_symmetric_functions _ _) result = symmetric_view "Plethysm" result
project (branch_partition_up _) result = partitions_view "Branch up" result
project (branch_partition_down _) result = partitions_view "Branch down" result
project (enumerate_young_graph_paths _ _) result = Inspection "Young graph paths"
  (("Paths: " ++ show (length result)) ::
     map (\path ⇒ concat (intersperse " → " (map partition_text path))) result)
  [] (concat result) []
project (generate_random_permutation _ _) (permutation, next) = Inspection "Random permutation"
  [show permutation, rng_text next] [] [] []
project (generate_random_standard_tableau _ _) (tableau, next) = Inspection "Random standard tableau"
  [show tableau.rows, rng_text next] [tableau] [] []
project (sample_plancherel_partition _ _) (shape, next) = Inspection "Sample Plancherel partition"
  [partition_text shape, rng_text next] [] [shape] []
project (longest_increasing_subsequence _) result = sequence_view "Longest increasing subsequence" result
project (longest_decreasing_subsequence _) result = sequence_view "Longest decreasing subsequence" result
project (coxeter_word _) result = Inspection "Coxeter reduced word"
  [show result, "Length: " ++ show (length result)] [] [] []
project (bruhat_relation _ _) result = Inspection "Bruhat relations"
  ["First ≤ second: " ++ show result] [] [] []

public export
inspect_operation : operation → Either Text LaboratoryView
inspect_operation request = do
  result ← evaluate request
  Right (project request result)

public export
sample_requests : List operation
sample_requests =
  [display_partition partition,
   conjugate_partition partition,
   list_cells partition,
   display_tableau tableau,
   validate_tableau standard_filling increasing_entries tableau,
   standardize_tableau (MkTableau [[1,1,3],[2,3]]),
   insert_letter (MkTableau [[1,3],[2,4]]) 2,
   reverse_insertion square (MkCell 2 2),
   transpose_filling tableau,
   compute_hook_lengths partition,
   compute_hook_product partition,
   count_standard_tableaux partition,
   find_corners partition,
   find_addable_cells partition,
   find_removable_cells partition,
   add_partition_cell partition (MkCell 3 1),
   remove_partition_cell partition (MkCell 1 3),
   rsk_from_permutation [3,1,4,2],
   rsk_from_word [2,1,2],
   rsk_from_biword [(1,2),(1,2),(2,1)],
   rsk_from_matrix [[0,2],[1,0]],
   inverse_rsk (MkTableau [[1,2],[3,4]]) (MkTableau [[1,3],[2,4]]),
   jeu_de_taquin_slide skew (MkCell 1 1),
   rectify_tableau skew,
   promote_tableau square,
   evacuate_tableau square,
   lr_coefficient (MkPartition [2,1]) (MkPartition [2,1]) (MkPartition [3,2,1]),
   enumerate_lr_tableaux (MkPartition [2,1]) (MkPartition [2,1]) (MkPartition [3,2,1]),
   multiply_schur_functions (MkPartition [1]) (MkPartition [1]),
   symmetric_character_value (MkPartition [2,1]) [2,3,1],
   representation_dimension partition,
   change_symmetric_basis schur_two PowerSum,
   specialize_symmetric_function (MkSymmetricFunction Schur
     [MkSymmetricTerm (MkPartition [2,1]) (MkRational 1 1)]) [1,2],
   compose_symmetric_functions schur_two schur_two,
   branch_partition_up partition,
   branch_partition_down partition,
   enumerate_young_graph_paths (MkPartition []) (MkPartition [2,1]),
   generate_random_permutation 4 stream,
   generate_random_standard_tableau (MkPartition [2,1]) stream,
   sample_plancherel_partition 4 stream,
   longest_increasing_subsequence [3,1,4,2],
   longest_decreasing_subsequence [3,1,4,2],
   coxeter_word [3,1,4,2],
   bruhat_relation [1,2,3] [3,2,1]]
  where
    partition : Partition
    partition = MkPartition [3,2]

    tableau : Tableau
    tableau = MkTableau [[1,2,4],[3,5]]

    square : Tableau
    square = MkTableau [[1,2],[3,4]]

    skew : SkewTableau
    skew = MkSkewTableau (MkPartition [3,2,1]) (MkPartition [1]) [[1,3],[2,5],[4]]

    schur_two : SymmetricFunction
    schur_two = MkSymmetricFunction Schur [MkSymmetricTerm (MkPartition [2]) (MkRational 1 1)]

    stream : RNGState
    stream = MkRNGState 0
