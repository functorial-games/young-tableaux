module Young.Laboratory

import Data.List
import Data.Maybe
import Data.Text
import Young.Core
import Young.Advanced

-- An ordinary laboratory request owns its actual inputs and result type.
-- This module has no knowledge of window state, model revisions or pixels.
public export
choice filling_rule one_of
  arbitrary_filling
  row_standard_filling
  column_standard_filling
  standard_filling
  semistandard_filling

public export
choice entry_order one_of
  increasing_entries
  decreasing_entries

public export
choice operation one_of
  display_partition Partition
  conjugate_partition Partition
  list_cells Partition
  display_tableau Tableau
  validate_tableau filling_rule entry_order Tableau
  standardize_tableau Tableau
  insert_letter Tableau Integer
  reverse_insertion Tableau Cell
  transpose_filling Tableau
  compute_hook_lengths Partition
  compute_hook_product Partition
  count_standard_tableaux Partition
  find_corners Partition
  find_addable_cells Partition
  find_removable_cells Partition
  add_partition_cell Partition Cell
  remove_partition_cell Partition Cell
  rsk_from_permutation (List Integer)
  rsk_from_word (List Integer)
  rsk_from_biword (List (Integer, Integer))
  rsk_from_matrix (List (List Number))
  inverse_rsk Tableau Tableau
  jeu_de_taquin_slide SkewTableau Cell
  rectify_tableau SkewTableau
  promote_tableau Tableau
  evacuate_tableau Tableau
  lr_coefficient Partition Partition Partition
  enumerate_lr_tableaux Partition Partition Partition
  multiply_schur_functions Partition Partition
  symmetric_character_value Partition (List Integer)
  representation_dimension Partition
  change_symmetric_basis SymmetricFunction SymmetricBasis
  specialize_symmetric_function SymmetricFunction (List Integer)
  compose_symmetric_functions SymmetricFunction SymmetricFunction
  branch_partition_up Partition
  branch_partition_down Partition
  enumerate_young_graph_paths Partition Partition
  generate_random_permutation Number RNGState
  generate_random_standard_tableau Partition RNGState
  sample_plancherel_partition Number RNGState
  longest_increasing_subsequence (List Integer)
  longest_decreasing_subsequence (List Integer)
  coxeter_word (List Integer)
  bruhat_relation (List Integer) (List Integer)

public export
OutputFor : operation → Type
OutputFor (display_partition _) = Partition
OutputFor (conjugate_partition _) = Partition
OutputFor (list_cells _) = List Cell
OutputFor (display_tableau _) = Tableau
OutputFor (validate_tableau _ _ _) = Bool
OutputFor (standardize_tableau _) = Tableau
OutputFor (insert_letter _ _) = InsertionResult
OutputFor (reverse_insertion _ _) = (Tableau, Integer)
OutputFor (transpose_filling _) = Tableau
OutputFor (compute_hook_lengths _) = List (Cell, Number)
OutputFor (compute_hook_product _) = Integer
OutputFor (count_standard_tableaux _) = Integer
OutputFor (find_corners _) = List Cell
OutputFor (find_addable_cells _) = List Cell
OutputFor (find_removable_cells _) = List Cell
OutputFor (add_partition_cell _ _) = Partition
OutputFor (remove_partition_cell _ _) = Partition
OutputFor (rsk_from_permutation _) = RSKResult
OutputFor (rsk_from_word _) = RSKResult
OutputFor (rsk_from_biword _) = RSKResult
OutputFor (rsk_from_matrix _) = RSKResult
OutputFor (inverse_rsk _ _) = List Integer
OutputFor (jeu_de_taquin_slide _ _) = SkewTableau
OutputFor (rectify_tableau _) = SkewTableau
OutputFor (promote_tableau _) = Tableau
OutputFor (evacuate_tableau _) = Tableau
OutputFor (lr_coefficient _ _ _) = Integer
OutputFor (enumerate_lr_tableaux _ _ _) = List SkewTableau
OutputFor (multiply_schur_functions _ _) = SymmetricFunction
OutputFor (symmetric_character_value _ _) = Integer
OutputFor (representation_dimension _) = Integer
OutputFor (change_symmetric_basis _ _) = SymmetricFunction
OutputFor (specialize_symmetric_function _ _) = Rational
OutputFor (compose_symmetric_functions _ _) = SymmetricFunction
OutputFor (branch_partition_up _) = List Partition
OutputFor (branch_partition_down _) = List Partition
OutputFor (enumerate_young_graph_paths _ _) = List (List Partition)
OutputFor (generate_random_permutation _ _) = (List Integer, RNGState)
OutputFor (generate_random_standard_tableau _ _) = (Tableau, RNGState)
OutputFor (sample_plancherel_partition _ _) = (Partition, RNGState)
OutputFor (longest_increasing_subsequence _) = List Integer
OutputFor (longest_decreasing_subsequence _) = List Integer
OutputFor (coxeter_word _) = List Number
OutputFor (bruhat_relation _ _) = Bool

public export
record LaboratoryView where
  constructor Inspection
  title : Text
  lines : List Text
  tableaux : List Tableau
  partitions : List Partition
  skews : List SkewTableau

-- Application admission is explicit, distinct from unbounded mathematical
-- partitions in Core. No result is clipped or called complete at a bound.
admit_partition : Partition → Either Text Partition
admit_partition candidate = do
  checked ← make_partition candidate.rows
  if length checked.rows <= 64 && all (<= 64) checked.rows && partition_size checked <= 256
     then Right checked
     else Left "The laboratory shape limit is 64 rows, 64 columns and 256 cells"

admit_tableau : Tableau → Either Text Tableau
admit_tableau candidate = do
  checked ← make_tableau candidate.rows
  _ ← admit_partition (tableau_shape checked)
  Right checked

admit_skew : SkewTableau → Either Text SkewTableau
admit_skew candidate = do
  _ ← admit_partition candidate.outer
  _ ← admit_partition candidate.inner
  make_skew candidate.outer candidate.inner candidate.rows

admit_letters : Number → Either Text ()
admit_letters size =
  if size <= 64 then Right () else Left "The laboratory input limit is 64 letters"

ordered_entries : entry_order → Bool → Integer → Integer → Bool
ordered_entries increasing_entries weak first second = if weak then first <= second else first < second
ordered_entries decreasing_entries weak first second = if weak then first >= second else first > second

ordered_row : entry_order → Bool → List Integer → Bool
ordered_row order weak [] = True
ordered_row order weak [_] = True
ordered_row order weak (first :: second :: rest) =
  ordered_entries order weak first second && ordered_row order weak (second :: rest)

ordered_columns : entry_order → Tableau → Bool
ordered_columns order tableau = all below_ordered (tableau_cells tableau)
  where
    below_ordered : (Cell, Integer) → Bool
    below_ordered (cell, value) = case tableau_get tableau (MkCell (S cell.row) cell.column) of
      Nothing ⇒ True
      Just below ⇒ ordered_entries order False value below

standard_letters : Tableau → Bool
standard_letters tableau =
  sort (concat tableau.rows) ≟ map cast [1 .. partition_size (tableau_shape tableau)]

satisfies_rule : filling_rule → entry_order → Tableau → Bool
satisfies_rule arbitrary_filling order tableau = True
satisfies_rule row_standard_filling order tableau =
  standard_letters tableau && all (ordered_row order False) tableau.rows
satisfies_rule column_standard_filling order tableau =
  standard_letters tableau && ordered_columns order tableau
satisfies_rule standard_filling order tableau =
  standard_letters tableau && all (ordered_row order False) tableau.rows && ordered_columns order tableau
satisfies_rule semistandard_filling order tableau =
  all (all (> 0)) tableau.rows && all (ordered_row order True) tableau.rows && ordered_columns order tableau

hooks_for : Partition → Either Text (List (Cell, Number))
hooks_for shape = traverse hook_at (partition_cells shape)
  where
    hook_at : Cell → Either Text (Cell, Number)
    hook_at cell = case hook_length shape cell of
      Nothing ⇒ Left "A hook was requested outside the checked shape"
      Just length ⇒ Right (cell, length)

public export
evaluate : (request : operation) → Either Text (OutputFor request)
evaluate (display_partition shape) = admit_partition shape
evaluate (conjugate_partition shape) = do
  checked ← admit_partition shape
  Right (conjugate checked)
evaluate (list_cells shape) = do
  checked ← admit_partition shape
  Right (partition_cells checked)
evaluate (display_tableau tableau) = admit_tableau tableau
evaluate (validate_tableau rule order tableau) = do
  checked ← admit_tableau tableau
  Right (satisfies_rule rule order checked)
evaluate (standardize_tableau tableau) = do
  checked ← admit_tableau tableau
  standardize checked
evaluate (insert_letter tableau letter) = do
  checked ← admit_tableau tableau
  result ← insert checked letter
  _ ← admit_tableau result.tableau
  Right result
evaluate (reverse_insertion tableau cell) = do
  checked ← admit_tableau tableau
  reverse_insert checked cell
evaluate (transpose_filling tableau) = do
  checked ← admit_tableau tableau
  transpose_tableau checked
evaluate (compute_hook_lengths shape) = do
  checked ← admit_partition shape
  hooks_for checked
evaluate (compute_hook_product shape) = do
  checked ← admit_partition shape
  Right (hook_product checked)
evaluate (count_standard_tableaux shape) = do
  checked ← admit_partition shape
  Right (standard_count checked)
evaluate (find_corners shape) = do
  checked ← admit_partition shape
  Right (removable_cells checked)
evaluate (find_addable_cells shape) = do
  checked ← admit_partition shape
  Right (addable_cells checked)
evaluate (find_removable_cells shape) = do
  checked ← admit_partition shape
  Right (removable_cells checked)
evaluate (add_partition_cell shape cell) = do
  checked ← admit_partition shape
  result ← add_cell checked cell
  admit_partition result
evaluate (remove_partition_cell shape cell) = do
  checked ← admit_partition shape
  remove_cell checked cell
evaluate (rsk_from_permutation letters) = do
  _ ← admit_letters (length letters)
  rsk_permutation letters
evaluate (rsk_from_word letters) = do
  _ ← admit_letters (length letters)
  rsk_word letters
evaluate (rsk_from_biword letters) = do
  _ ← admit_letters (length letters)
  rsk_biword letters
evaluate (rsk_from_matrix rows) = do
  _ ← admit_letters (length rows)
  _ ← admit_letters (foldl max 0 (map length rows))
  _ ← admit_letters (sum (map sum rows))
  rsk_matrix rows
evaluate (inverse_rsk insertion recording) = do
  first ← admit_tableau insertion
  second ← admit_tableau recording
  _ ← admit_letters (partition_size (tableau_shape first))
  inverse_permutation_rsk first second
evaluate (jeu_de_taquin_slide filling cell) = do
  checked ← admit_skew filling
  state ← make_jeu checked
  result ← jeu_slide state cell
  Right result.filling
evaluate (rectify_tableau filling) = do
  checked ← admit_skew filling
  state ← make_jeu checked
  result ← rectify state
  Right result.filling
evaluate (promote_tableau tableau) = do
  checked ← admit_tableau tableau
  promotion checked
evaluate (evacuate_tableau tableau) = do
  checked ← admit_tableau tableau
  evacuation checked
evaluate (lr_coefficient inner content outer) = do
  _ ← admit_partition inner
  _ ← admit_partition content
  _ ← admit_partition outer
  littlewood_richardson_coefficient inner content outer
evaluate (enumerate_lr_tableaux inner content outer) = do
  _ ← admit_partition inner
  _ ← admit_partition content
  _ ← admit_partition outer
  littlewood_richardson_tableaux inner content outer
evaluate (multiply_schur_functions first second) = do
  _ ← admit_partition first
  _ ← admit_partition second
  schur_product first second
evaluate (symmetric_character_value shape permutation) = do
  _ ← admit_partition shape
  character_value shape permutation
evaluate (representation_dimension shape) = do
  checked ← admit_partition shape
  Right (standard_count checked)
evaluate (change_symmetric_basis function basis) = change_basis function basis
evaluate (specialize_symmetric_function function alphabet) = specialize function alphabet
evaluate (compose_symmetric_functions outer inner) = plethysm outer inner
evaluate (branch_partition_up shape) = do
  checked ← admit_partition shape
  results ← branch_up checked
  traverse admit_partition results
evaluate (branch_partition_down shape) = do
  checked ← admit_partition shape
  branch_down checked
evaluate (enumerate_young_graph_paths start finish) = do
  _ ← admit_partition start
  _ ← admit_partition finish
  young_graph_paths start finish
evaluate (generate_random_permutation size stream) = random_permutation size stream
evaluate (generate_random_standard_tableau shape stream) = do
  checked ← admit_partition shape
  random_standard_tableau checked stream
evaluate (sample_plancherel_partition size stream) = sample_plancherel size stream
evaluate (longest_increasing_subsequence permutation) = permutation_lis permutation
evaluate (longest_decreasing_subsequence permutation) = permutation_lds permutation
evaluate (coxeter_word permutation) = coxeter_reduced_word permutation
evaluate (bruhat_relation first second) = bruhat_leq first second

-- These exact symbols correspond to app/console/operations.def. They identify
-- a request; only evaluate and the resulting value establish execution.
public export
