#!/usr/bin/env grease

# Actual Idriç host execution. No Android behavior follows from this receipt.
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: qualify-host.grease PROJECT IDRIC_REPOSITORY CHEZ NEW_OUTPUT_DIRECTORY'
  exit 2
}
var project = ARGV[0]
var compiler_repository = ARGV[1]
var chez = ARGV[2]
var output = ARGV[3]
for path in ([project, compiler_repository, chez, output]) {
  if (not path.startsWith('/')) {
    echo 'FAIL: all qualification paths must be absolute'
    exit 2
  }
}
var sources = "$project/examples/autogenerated/young-tableau-app"
var compiler = "$compiler_repository/_/build/exec/idris2"
var prefix = "$compiler_repository/_/bootstrap-build"
var base = "$prefix/idris2-0.8.0/base-0.8.0"
var prelude = "$prefix/idris2-0.8.0/prelude-0.8.0"
var support = "$compiler_repository/_/build/exec/idris2_app/libidris2_support.so"
var executable = "$output/exec/young-idric"
var payload = "$output/exec/young-idric_app/young-idric.so"
var receipt = "$output/receipt.tsv"

proc fail(message) {
  printf 'status\tFAIL\nreason\t%s\n' "$message" >> "$receipt"
  printf '\033[31mFAIL\033[0m %s\n' "$message" >&2
  exit 1
}

proc require_file(path) {
  if ! test -s "$path" { fail "missing or empty required file: $path" }
}

proc reject_error_log(path) {
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR|Exception:|Killed)' "$path" {
    fail "compiler or runtime diagnostic in $path"
  }
}

proc source_inventory(path) {
  rg --files -g '*.idric' "$sources" | sort | xargs -d '\n' -r sha256sum > "$path"
  require_file "$path"
}

if test -e "$output" {
  printf '\033[31mFAIL\033[0m output must be new: %s\n' "$output" >&2
  exit 1
}
mkdir -p "$output"
printf 'schema\tyoung-idric-host-v1\nandroid_lowering\tNOT_RUN\nandroid_presentation\tNOT_RUN\nphysical_device\tNOT_RUN\nfallback\tnone\n' > "$receipt"
if ! test -x "$compiler" { fail 'the declared Idriç compiler is not executable' }
if ! test -x "$chez" { fail 'the declared Chez host backend is not executable' }
require_file "$base/base.ipkg"
require_file "$prelude/prelude.ipkg"
require_file "$support"
require_file "$sources/Main.idric"
var compiler_revision = $(git -C "$compiler_repository" rev-parse HEAD)
if ! test "$compiler_revision" = ff4d852862a3942592f8ade9afde8d409d9803be {
  fail 'compiler source differs from the declared qualification revision'
}
var application_base = $(git -C "$project" rev-parse HEAD)
printf 'application_base\t%s\ncompiler_source\t%s\nhost_backend\tchez\n' "$application_base" "$compiler_revision" >> "$receipt"
git -C "$project" status --porcelain > "$output/application-worktree.txt"
uname -srm > "$output/host.txt"
"$compiler" --version > "$output/compiler-version.txt"
"$chez" --version > "$output/chez-version.txt" 2>&1
sha256sum "$compiler_repository/_/build/exec/idris2_app/idris2.so" "$support" > "$output/compiler-sha256.txt"
source_inventory "$output/source-before.sha256"

printf '\033[36mACTION\033[0m Compile the maintained Idriç application for its Chez host backend\n'
printf '%s\n' "$compiler" '--cg chez' "--source-dir $sources" "--build-dir $output/build" "--output-dir $output/exec" "$sources/Main.idric" '-o young-idric' > "$output/build-command.txt"
if ! env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$base:$prelude" IDRIS2_CG=chez CHEZ="$chez" \
  "$compiler" --cg chez --source-dir "$sources" --build-dir "$output/build" \
  --output-dir "$output/exec" --no-color "$sources/Main.idric" -o young-idric \
  > "$output/build.stdout" 2> "$output/build.stderr" {
  fail 'Idriç host compilation returned failure'
}
# This compiler sometimes prints an error while returning zero. Fresh artifacts,
# clean diagnostics, and an executed assertion marker are all required.
reject_error_log "$output/build.stdout"
reject_error_log "$output/build.stderr"
require_file "$executable"
require_file "$payload"
if ! test -x "$executable" { fail 'the fresh host artifact is not executable' }
cp "$support" "$output/exec/young-idric_app/libidris2_support.so"
sha256sum "$executable" "$payload" "$output/exec/young-idric_app/libidris2_support.so" > "$output/executable-sha256.txt"
printf 'source_compilation\tPASS\n' >> "$receipt"

mkdir -p "$output/frames"
printf '\033[36mACTION\033[0m Run model, renderer, and presentation assertions\n'
printf '%s\n' "$executable" '--self-test' "$output/frames" > "$output/run-command.txt"
if ! "$executable" --self-test "$output/frames" > "$output/run.stdout" 2> "$output/run.stderr" {
  fail 'Idriç application assertions returned failure'
}
reject_error_log "$output/run.stdout"
reject_error_log "$output/run.stderr"
if ! rg -qx 'YOUNG_IDRIC_PASS' "$output/run.stdout" {
  fail 'the executed application did not report its complete assertion marker'
}

proc expect_type_refusal(name, expected) {
  var negative = "$sources/Tests/Negative/$name.idric"
  var negative_build = "$output/negative-types/$name"
  require_file "$negative"
  mkdir -p "$negative_build"
  printf '\033[36mACTION\033[0m Check rejected frame construction: %s\n' "$name"
  if env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$base:$prelude" \
    "$compiler" --source-dir "$sources" --build-dir "$negative_build/build" \
    --no-color --check "$negative" > "$negative_build/check.txt" 2>&1 {
    echo 'compiler_exit=zero; exact diagnostic and absent target TTC are required' > "$negative_build/exit.txt"
  } else {
    echo 'compiler_exit=nonzero; exact diagnostic and absent target TTC are required' > "$negative_build/exit.txt"
  }
  if ! rg -q '^Error:' "$negative_build/check.txt" { fail "$name was not rejected by the type checker" }
  if ! rg -Fq "$expected" "$negative_build/check.txt" { fail "$name failed for a different constraint" }
  if rg --files --hidden --no-ignore "$negative_build/build" -g "$name.ttc" > "$negative_build/unexpected-ttc.txt" {
    fail "$name unexpectedly produced a checked module"
  }
  printf 'negative_type_%s\tPASS; intended constraint refused\n' "$name" >> "$receipt"
}

expect_type_refusal StaleFrame 'Mismatch between: previous and current.'
expect_type_refusal InventedFrame "Can't solve constraint between: Raster and Frame source."

rg --files -g '*.ppm' "$output/frames" | sort > "$output/frame-paths.txt"
require_file "$output/frame-paths.txt"
xargs -d '\n' -r sha256sum < "$output/frame-paths.txt" > "$output/frames.sha256"
require_file "$output/frames.sha256"
source_inventory "$output/source-after.sha256"
if ! cmp "$output/source-before.sha256" "$output/source-after.sha256" {
  fail 'application source changed during qualification'
}
printf 'host_assertions\tPASS\nhost_pixel_files\tPASS\nsource_stable_during_run\tPASS\nstatus\tPASS\n' >> "$receipt"
printf '\033[32mPASS\033[0m Idriç host assertions and pixel output\n'
printf '\033[33mNOT_RUN\033[0m Android lowering, window presentation, and physical-device behavior\n'
