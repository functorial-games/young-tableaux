#!/usr/bin/env grease

# These two mutations reproduce the user's concrete stale-picture failure risk.
# Only fresh isolated source copies are changed. A positive host receipt is
# required first, and a compiler error never counts as a rejected runtime mutant.
set -eu -o pipefail
if (len(ARGV) !== 5) {
  echo 'usage: qualify-mutants.grease PROJECT IDRIC_REPOSITORY CHEZ SUCCESSFUL_HOST_RUN NEW_OUTPUT_DIRECTORY'
  exit 2
}
var project = ARGV[0]
var compiler_repository = ARGV[1]
var chez = ARGV[2]
var positive = ARGV[3]
var output = ARGV[4]
for path in ([project, compiler_repository, chez, positive, output]) {
  if (not path.startsWith('/')) {
    echo 'FAIL: all mutation qualification paths must be absolute'
    exit 2
  }
}
var sources = $(realpath "$project/examples/autogenerated/young-tableau-app")
var destination = $(realpath -m "$output")
if (destination === sources or destination.startsWith(sources + '/')) {
  echo 'FAIL: mutation output must be outside the maintained source tree'
  exit 2
}
if test -e "$output" {
  echo 'FAIL: mutation output must be a fresh directory'
  exit 2
}
mkdir -p "$output"
var receipt = "$output/receipt.tsv"
printf 'schema\tyoung-idric-mutants-v1\nandroid_execution\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$receipt"
var compiler = "$compiler_repository/_/build/exec/idris2"
var prefix = "$compiler_repository/_/bootstrap-build"
var base = "$prefix/idris2-0.8.0/base-0.8.0"
var prelude = "$prefix/idris2-0.8.0/prelude-0.8.0"
var support = "$compiler_repository/_/build/exec/idris2_app/libidris2_support.so"
var snapshot = "$output/original-source"

proc fail(message) {
  printf 'status\tFAIL\nreason\t%s\n' "$message" >> "$receipt"
  printf '\033[31mFAIL\033[0m %s\n' "$message" >&2
  exit 1
}

proc require_file(path) {
  if ! test -s "$path" { fail "missing or empty required file: $path" }
}

proc reject_error_log(path) {
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR|Exception:|Killed)' "$path" {
    fail "unrelated compiler or runtime error in $path"
  }
}

proc require_one_line(path, line, evidence) {
  if ! rg -Fx "$line" "$path" > "$evidence" { fail 'the intended mutation source line is absent' }
  var count = $(wc -l < "$evidence")
  if ! test "$count" -eq 1 { fail 'the intended mutation source line is not unique' }
}

require_file "$sources/Main.idric"
require_file "$positive/receipt.tsv"
require_file "$positive/source-after.sha256"
require_file "$positive/executable-sha256.txt"
if ! rg -qx 'status[[:space:]]PASS' "$positive/receipt.tsv" { fail 'successful positive host qualification is required' }
if ! rg -qx 'YOUNG_IDRIC_PASS' "$positive/run.stdout" { fail 'positive application assertion marker is absent' }
if ! sha256sum -c "$positive/source-after.sha256" > "$output/original-before.txt" 2>&1 {
  fail 'original source differs from the successful host run'
}
if ! sha256sum -c "$positive/executable-sha256.txt" > "$output/positive-executable.txt" 2>&1 {
  fail 'positive executable differs from the successful host run'
}
var compiler_revision = $(git -C "$compiler_repository" rev-parse HEAD)
if ! test "$compiler_revision" = ff4d852862a3942592f8ade9afde8d409d9803be {
  fail 'compiler source differs from the declared qualification revision'
}
if ! test -x "$compiler" { fail 'the declared Idriç compiler is not executable' }
if ! test -x "$chez" { fail 'the declared Chez host backend is not executable' }
require_file "$support"
cp -R "$sources" "$snapshot"

proc run_mutant(name) {
  var work = "$output/$name"
  mkdir -p "$work"
  cp -R "$snapshot" "$work/source"
  var source_file = "$work/source/Young/Screen.idric"
  var assertion = 'RSK input-to-pixels changes P pane'
  if (name === 'blank-picture') {
    require_one_line "$source_file" 'paint source = rasterize screen_width (content_height source) (scene source)' "$work/original-line.txt"
    sed 's/^paint source = rasterize screen_width (content_height source) (scene source)$/paint source = rasterize screen_width (content_height source) []/' "$source_file" > "$work/replacement.idric"
    printf '%s\n' 'Discard the model-derived scene and paint the empty scene.' > "$work/mutation.txt"
  } else {
    setvar source_file = "$work/source/Young/Model.idric"
    setvar assertion = 'basic actions preserve sequential RSK input and navigation'
    require_one_line "$source_file" '  Right ({ revision := S model.revision } changed)' "$work/original-line.txt"
    sed 's/^  Right ({ revision := S model[.]revision } changed)$/  Right model/' "$source_file" > "$work/replacement.idric"
    printf '%s\n' 'Return the previous model after every accepted action.' > "$work/mutation.txt"
  }
  if cmp -s "$source_file" "$work/replacement.idric" { fail 'the mutation did not change the isolated source' }
  mv "$work/replacement.idric" "$source_file"
  sha256sum "$source_file" > "$work/mutated-source.sha256"
  printf 'YOUNG_IDRIC_FAIL\t%s\n' "$assertion" > "$work/expected-assertion.txt"
  printf '\033[36mACTION\033[0m Compile and execute the %s mutation\n' "$name"
  cd "$work/source"
  if ! env IDRIS2_PREFIX="$prefix" IDRIS2_PATH="$base:$prelude" IDRIS2_CG=chez CHEZ="$chez" \
    "$compiler" --cg chez --source-dir "$work/source" --build-dir "$work/build" \
    --output-dir "$work/exec" --no-color "$work/source/Main.idric" -o young-idric \
    > "$work/build.stdout" 2> "$work/build.stderr" {
    fail "$name did not compile; this is not a runtime mutation observation"
  }
  reject_error_log "$work/build.stdout"
  reject_error_log "$work/build.stderr"
  var executable = "$work/exec/young-idric"
  var payload = "$work/exec/young-idric_app/young-idric.so"
  require_file "$executable"
  require_file "$payload"
  cp "$support" "$work/exec/young-idric_app/libidris2_support.so"
  sha256sum "$executable" "$payload" > "$work/executable.sha256"
  mkdir -p "$work/frames"
  if "$executable" --self-test "$work/frames" > "$work/run.stdout" 2> "$work/run.stderr" {
    fail "$name unexpectedly exited successfully"
  }
  reject_error_log "$work/run.stdout"
  reject_error_log "$work/run.stderr"
  if ! rg -F -x -f "$work/expected-assertion.txt" "$work/run.stdout" > "$work/detected-assertions.txt" {
    fail "$name failed without the intended application assertion"
  }
  if rg -qx 'YOUNG_IDRIC_PASS' "$work/run.stdout" { fail "$name also reported a contradictory success" }
  printf '%s\tPASS; compiled mutant rejected by application assertion\n' "$name" >> "$receipt"
}

run_mutant blank-picture
run_mutant unchanged-model
if ! sha256sum -c "$positive/source-after.sha256" > "$output/original-after.txt" 2>&1 {
  fail 'maintained source changed during the mutation qualification'
}
printf 'maintained_source_unchanged\tPASS\nstatus\tPASS\n' >> "$receipt"
printf '\033[32mPASS\033[0m empty-picture and unchanged-model mutations are detected\n'
